{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "scripts": {
    "start": "bun index.ts",
    "dev": "concurrently \"bun --watch --env-file ../../.env index.ts\" \"npx prisma studio\"",
    "migrate": "npx prisma migrate dev && npx prisma generate client",
    "format:write": "prettier --write .",
    "lint:check": "eslint .",
    "lint:fix": "eslint --fix .",
    "typecheck": "tsc --noEmit",
    "test": "vitest"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "@types/mjml": "^4.7.4",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "globals": "^16.0.0",
    "prettier": "^3.5.2",
    "prisma": "^6.11.1",
    "prisma-erd-generator": "^2.0.4",
    "supertest": "^7.1.4",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.2.4"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@prisma/client": "^6.11.1",
    "@types/cors": "^2.8.19",
    "axios": "^1.11.0",
    "concurrently": "^9.1.2",
    "convert-csv-to-json": "^3.5.0",
    "cors": "^2.8.6",
    "csv-parse": "^6.1.0",
    "date-fns": "^4.1.0",
    "express": "^4.21.2",
    "form-data": "^4.0.4",
    "keyv": "^5.4.0",
    "mjml": "^4.15.3",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "open": "^10.2.0",
    "reflect-metadata": "^0.2.2",
    "socket.io": "^4.8.1",
    "ts-node": "^10.9.2",
    "tsyringe": "^4.10.0"
  }
}
