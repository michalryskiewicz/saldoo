// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// This database holds NO user data.
//
// Financial data lives in the browser (IndexedDB) and in an encrypted backup on
// the user's own Google Drive, under a key derived from their passphrase or
// recovery code. Identity is a Google access token verified against Google, not
// a session row. What remains here is a cache of public NBP exchange rates.
// ===========================================================================

enum CURRENCY {
  PLN
  EUR
  USD
}

model ExchangeRate {
  id           String   @id @default(uuid())
  fromCurrency CURRENCY
  toCurrency   CURRENCY
  mid          Float?
  bid          Float?
  ask          Float?

  effectiveDate DateTime

  // A rate for one currency pair on one day is a single immutable fact, so the
  // cache must not be able to hold two of them.
  @@unique([fromCurrency, toCurrency, effectiveDate])
}
