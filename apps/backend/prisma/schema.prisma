// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// SQLite, not Postgres: what is left is a cache of public NBP rates — a few hundred
// immutable rows a year — so a file needs no service, no credentials and no volume
// bigger than a floppy disk. Self-hosting Saldoo now needs Bun and nothing else.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// This database holds NO user data.
//
// Financial data lives in the browser (IndexedDB) and in an encrypted backup on
// the user's own Google Drive, under a key derived from their passphrase or
// recovery code. Identity is a Google access token verified against Google, not
// a session row.
//
// Everything here is a rebuildable cache: deleting the file costs nothing but a
// few requests to NBP.
// ===========================================================================

model ExchangeRate {
  id String @id @default(uuid())

  // Plain strings rather than an enum: Prisma does not support enums on SQLite.
  // The backend's own CURRENCY enum stays the source of truth in code.
  fromCurrency String
  toCurrency   String

  mid Float?
  bid Float?
  ask Float?

  effectiveDate DateTime

  // A rate for one currency pair on one day is a single immutable fact, so the
  // cache must not be able to hold two of them.
  @@unique([fromCurrency, toCurrency, effectiveDate])
}

// The retail bond offer, as published. Public data about somebody else's product — the same kind
// of thing as an NBP rate, and the same rebuildable cache: deleting these rows costs a few requests
// to the Ministry's own pages.
//
// It is not a substitute for the catalogue the app ships with. That one keeps working offline and
// keeps working if this table is empty; these rows are what stops somebody having to add a line to
// it by hand every month.
model BondOffer {
  id String @id @default(uuid())

  // The series code (EDO, COI, ROR …) and the month it was on sale, as YYYY-MM.
  series String
  month  String

  ratePercent   Float
  marginPercent Float?
  nominal       Float?

  /// Where it was read from, so a wrong figure can be traced to a page rather than argued about.
  source    String
  checkedAt DateTime

  // One issue per series per month is a single published fact, so the cache must not hold two.
  @@unique([series, month])
}
