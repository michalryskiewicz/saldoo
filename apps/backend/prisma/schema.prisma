// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// SQLite, not Postgres: what is left is a cache of public NBP rates — a few hundred
// immutable rows a year — so a file needs no service, no credentials and no volume
// bigger than a floppy disk. Self-hosting Saldoo now needs Bun and nothing else.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// This database holds NO user data.
//
// Financial data lives in the browser (IndexedDB) and in an encrypted backup on
// the user's own Google Drive, under a key derived from their passphrase or
// recovery code. Identity is a Google access token verified against Google, not
// a session row.
//
// Everything here is a rebuildable cache: deleting the file costs nothing but a
// few requests to NBP.
// ===========================================================================

model ExchangeRate {
  id String @id @default(uuid())

  // Plain strings rather than an enum: Prisma does not support enums on SQLite.
  // The backend's own CURRENCY enum stays the source of truth in code.
  fromCurrency String
  toCurrency   String

  mid Float?
  bid Float?
  ask Float?

  effectiveDate DateTime

  // A rate for one currency pair on one day is a single immutable fact, so the
  // cache must not be able to hold two of them.
  @@unique([fromCurrency, toCurrency, effectiveDate])
}
