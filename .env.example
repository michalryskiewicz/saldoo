# ===========================================
# Environment Variables for Saldoo
# ===========================================
# Copy this file to .env and fill in the values

# ============================================
# DATABASE
# ============================================
# Caches public NBP exchange rates. Holds no user data.
POSTGRES_PASSWORD=your_secure_postgres_password
POSTGRES_USER=saldoo_admin
POSTGRES_DB=saldoo
DATABASE_URL=postgresql://saldoo_admin:your_secure_postgres_password@postgres:5432/saldoo

# ============================================
# BACKEND
# ============================================
FRONTEND_URL=localhost:5173

# ============================================
# FRONTEND (Vite build args — passed at build time)
# ============================================
VITE_SERVER_URL=localhost:3000

# The one and only Google OAuth client. It is a browser (public) client, so there
# is no client secret to configure anywhere — the browser obtains the token
# directly from Google.
#
# In Google Cloud you must:
#   1. publish the OAuth app (Testing → In production), otherwise consent and
#      refresh expire after 7 days
#   2. add your app's origin under "Authorized JavaScript origins"
#   3. add the scopes: openid, email, profile, .../auth/drive.file
VITE_GOOGLE_CLIENT=your_google_client_id.apps.googleusercontent.com

VITE_GA_ID=G-XXXXXXXXXX
VITE_GA_DRIVE_DIRECTORY=saldoo
VITE_GA_DRIVE_FILE=saldoo.json

# Umami analytics (leave empty to disable — self-hosters should set their own)
VITE_UMAMI_WEBSITE_ID=
VITE_UMAMI_SRC=https://cloud.umami.is/script.js
